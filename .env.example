# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- MTProto (get from https://my.telegram.org -> API development tools) ---
API_ID=12345678
API_HASH=your_api_hash_here

# --- Session file name (created automatically on first login) ---
SESSION_NAME=userbot

# --- Google Gemini (get a key from https://aistudio.google.com) ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Notifier bot (create via @BotFather) ---
NOTIFIER_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_ID=123456789

# --- Optional tuning ---
# DB_PATH=userbot.db
# TYPING_DELAY_SECONDS=1.5
# CONTEXT_MESSAGE_COUNT=5
# SYSTEM_PROMPT=You are {name} (@{username}) responding personally on Telegram. Keep replies short, casual, and human-like.
